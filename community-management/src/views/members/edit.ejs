<%- include('../partials/header') %>

<div class="breadcrumb">
  <a href="/members">Members</a>
  <span>/</span>
  <span>Edit <%= member.name %></span>
</div>

<div class="page-header">
  <div>
    <h1>Edit Member</h1>
    <p class="subtitle">Update profile details, community membership, skills array, or contribution points.</p>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="banner error"><%= error %></div>
<% } %>

<% const skillsValue = Array.isArray(member.skills) ? member.skills.join(', ') : (member.skills || ''); %>

<div class="card form-card">
  <form method="POST" action="/members/<%= member._id %>/update">
    <div class="field-row">
      <div class="field">
        <label for="name">Full Name *</label>
        <input type="text" id="name" name="name" value="<%= member.name %>" required />
      </div>

      <div class="field">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" value="<%= member.email || '' %>" />
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="communityId">Community *</label>
        <select id="communityId" name="communityId" required>
          <% allCommunities.forEach((c) => { %>
            <option value="<%= c._id %>" <%= String(member.communityId) === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="field">
        <label for="role">Role</label>
        <select id="role" name="role">
          <% roles.forEach((r) => { %>
            <option value="<%= r %>" <%= member.role === r ? 'selected' : '' %>><%= r %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="skills">Skills (comma-separated)</label>
        <input type="text" id="skills" name="skills" value="<%= skillsValue %>" placeholder="MongoDB, Node.js, React" />
      </div>

      <div class="field">
        <label for="points">Contribution Points</label>
        <input type="number" id="points" name="points" min="0" value="<%= member.points || 0 %>" />
      </div>
    </div>

    <div class="field">
      <label for="bio">Short Bio</label>
      <textarea id="bio" name="bio" style="min-height:72px;"><%= member.bio || '' %></textarea>
    </div>

    <div class="form-actions">
      <button class="btn" type="submit">Save Changes</button>
      <a class="btn secondary" href="/members">Cancel</a>
    </div>
  </form>
</div>

<p class="muted">Joined <%= formatDate(member.joinedAt) %></p>

<%- include('../partials/footer') %>
