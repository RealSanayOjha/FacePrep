<%- include('../partials/header') %>

<h1>Create event</h1>
<p class="subtitle">Every event belongs to a community.</p>

<% const v = (typeof values !== 'undefined' && values) ? values : {}; %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="banner error"><%= error %></div>
<% } %>

<% if (allCommunities.length === 0) { %>
  <div class="empty">Create a community first. <a href="/communities/new">New community</a></div>
<% } else { %>
  <div class="card">
    <form method="POST" action="/events">
      <div class="field">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" value="<%= v.title || '' %>" placeholder="e.g. MongoDB Basics Workshop" required />
      </div>

      <div class="field">
        <label for="description">Description</label>
        <textarea id="description" name="description"><%= v.description || '' %></textarea>
      </div>

      <div class="field">
        <label for="date">Date</label>
        <input type="date" id="date" name="date" value="<%= v.date || '' %>" />
      </div>

      <div class="field">
        <label for="location">Location</label>
        <input type="text" id="location" name="location" value="<%= v.location || '' %>" placeholder="e.g. Lab 3, Poornima College" />
      </div>

      <div class="field">
        <label for="communityId">Community *</label>
        <select id="communityId" name="communityId" required>
          <option value="">-- choose a community --</option>
          <% allCommunities.forEach((c) => { %>
            <option value="<%= c._id %>" <%= String(preselected) === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-actions">
        <button class="btn" type="submit">Create event</button>
        <a class="btn secondary" href="/events">Cancel</a>
      </div>
    </form>
  </div>
<% } %>

<%- include('../partials/footer') %>
