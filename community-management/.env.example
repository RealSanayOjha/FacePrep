# Copy this file to .env and paste your MongoDB connection string.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional offline / instant demo mode (no local mongod required):
# MONGODB_URI=memory

# Database name that will be created automatically inside your cluster
DB_NAME=community_management

# Port the web app runs on
PORT=3000
